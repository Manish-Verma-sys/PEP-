# Copy to .env for local dev. NEVER commit your real .env.
# On Render, set these in the dashboard under Environment.

# Google Gemini API key. Server-side only; never sent to the browser.
# Powers BOTH the live regulatory research (Google Search grounding) and insights.
REGWATCH_API_KEY=

# Insight engine for the per-alert analysis on the detail page.
REGWATCH_PROVIDER=gemini

# Gemini model (needs Google Search grounding support). Default gemini-2.0-flash.
# REGWATCH_MODEL=gemini-2.0-flash

# Live research on/off. true = every load researches current regulatory changes
# via Gemini + Google Search (cached ~15 min). false = illustrative seed data.
REGWATCH_LIVE=true

# PORT is set automatically by Render.
