# Copy this file to .env for local development. NEVER commit your real .env.
# On Render, set these in the dashboard under Environment (not in code).

# Your Google Gemini API key. Read server-side only; never sent to the browser.
REGWATCH_API_KEY=

# How insights are generated:
#   gemini    -> Google Gemini API (use this for your Gemini key)
#   local     -> rule-based, no key needed (safe fallback)
#   anthropic -> Anthropic API
#   openai    -> OpenAI API
REGWATCH_PROVIDER=gemini

# Optional Gemini model override (default: gemini-2.0-flash).
# REGWATCH_MODEL=gemini-2.0-flash

# Set true to enable the live regulatory-source fetch layer (openFDA wired in).
REGWATCH_LIVE=false

# Port (Render sets this automatically; default 3000 locally).
# PORT=3000
